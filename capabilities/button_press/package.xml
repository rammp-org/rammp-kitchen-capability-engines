<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>button_press</name>
  <version>0.1.0</version>
  <description>Autonomous microwave button press (dome-layout detector, panel frame, gated straight-line approach, contact press) as a RAMMP capability engine.</description>
  <maintainer email="dhyi@andrew.cmu.edu">David Yi</maintainer>
  <license>MIT</license>

  <exec_depend>capability_engine</exec_depend>
  <exec_depend>capability_ui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rammp_perception_interfaces</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- pybullet has no rosdep key: pip, in the Dockerfile. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
